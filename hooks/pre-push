#!/bin/sh
# Delegate validation and Git's ref-update stdin to persisted Python.
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
if command -v python >/dev/null 2>&1; then
  exec python "$hook_dir/../helpers/git-local-checks.py" push "$@"
fi
if command -v py >/dev/null 2>&1; then
  exec py -3 "$hook_dir/../helpers/git-local-checks.py" push "$@"
fi
echo "Python 3 is required for workspace pre-push validation." >&2
exit 1
